# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo

# Added by `vercel link` — broader than the .env*.local rule above, so it also
# catches .env, .env.production, and the VERCEL_OIDC_TOKEN it writes locally.
.env*
# …but the committed template must stay visible to new contributors.
!.env.local.example

# Editor-specific Codacy AI rules, generated by the extension.
.github/instructions/codacy.instructions.md

# Codacy CLI working directory — the tool configuration is pulled down from the
# Codacy API on demand, so it is a cache rather than a source of truth.
.codacy/

# CodeGraph index — a generated SQLite database, rebuilt with `codegraph index`.
# Ignoring it does not affect how CodeGraph works locally.
.codegraph/

# Coverage output, regenerated by `npm run test:coverage`.
/coverage
