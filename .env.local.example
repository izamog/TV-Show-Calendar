# TMDB API credentials.
#
# You may supply EITHER a v3 API key OR a v4 read access token (Bearer).
# If both are present, the v4 read access token is preferred.
#
# Get these from https://www.themoviedb.org/settings/api

# v3 API key (short alphanumeric string)
TMDB_API_KEY=

# v4 read access token (long JWT starting with "eyJ..."). Optional.
TMDB_READ_ACCESS_TOKEN=

# Optional: public base URL used to build the absolute iCal feed link.
# On Vercel this is provided automatically as VERCEL_URL, so you normally
# do not need to set this. Set it only for custom domains, e.g.
# NEXT_PUBLIC_SITE_URL=https://my-tv-tracker.example.com
NEXT_PUBLIC_SITE_URL=

# Optional: push the season feed into an Airtable table on each cron refresh.
# All three must be set or the sync is skipped entirely — the calendar runs
# perfectly well without them.
#
# Create a personal access token at https://airtable.com/create/tokens with
# scope `data.records:write`, granted access to the destination base.
AIRTABLE_TOKEN=
# Base and table ids, both visible in the Airtable API URL for your table:
# https://airtable.com/appXXXXXXXXXXXXXX/tblXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Optional: IMDb ratings, via OMDb (https://www.omdbapi.com/apikey.aspx).
#
# TMDB's API carries a show's IMDb *id* but never its IMDb *rating*, so the
# IMDb half of the blended score comes from OMDb. Unset, ratings fall back to
# TMDB's own vote_average alone — the calendar and the fill logic both still
# work, they are just ranking on one source instead of two.
#
# The free tier allows 1,000 requests/day; one request per qualifying show per
# hour of cache sits well inside that.
OMDB_API_KEY=
